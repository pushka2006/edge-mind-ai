# ==========================================================
# EDGE MIND AI — Environment Configuration
# ==========================================================

# Database & Edge State
DATABASE_URL="file:./edge_memory.db"

# Qdrant Edge (Local Semantic Daemon)
# Runs embedded on-device or connects to local Docker Qdrant
QDRANT_EDGE_URL="http://127.0.0.1:6333"
QDRANT_EDGE_COLLECTION="edge_memories"
QDRANT_EDGE_API_KEY=""

# Qdrant Server (Centralized Cloud Fleet Storage)
QDRANT_SERVER_URL="https://qdrant.cloud.internal:6333"
QDRANT_SERVER_COLLECTION="cloud_edge_memories"
QDRANT_SERVER_API_KEY="qdrant_cloud_live_secret_key"

# AI Inference & Embeddings
AI_API_KEY=""
EMBEDDING_API_KEY=""
AI_PROVIDER="hybrid"
LOCAL_MODEL_NAME="EdgeMind-Nano-8B"
CLOUD_MODEL_NAME="EdgeMind-Titan-Cloud"

# Security & Cryptography
AUTH_SECRET="edgemind_enterprise_jwt_secret_token_0987"
ENCRYPTION_KEY="edgemind_aes256_hardware_enclave_key_1234"
TPM_ISOLATION_ENABLED="true"

# Fleet Configuration
DEFAULT_DEVICE_ID="DEV-001"
DEFAULT_ORG_ID="ORG-804"
